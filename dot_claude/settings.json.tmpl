{
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "outputStyle": "Concise",
  "theme": "dark-ansi",
  "agentPushNotifEnabled": true,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/bin/claude-tmux hook",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/bin/claude-tmux hook",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/bin/claude-tmux hook",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/bin/claude-tmux hook",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/bin/claude-tmux hook",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/bin/claude-tmux hook",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/bin/claude-tmux hook",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/bin/claude-tmux hook",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "autoMode": {
    "environment": {{ $f := joinPath .chezmoi.homeDir ".config/chezmoi/claude-environment.json" }}{{ if stat $f }}{{ include $f | trim }}{{ else }}[]{{ end }},
    "allow": [
      "$defaults",
      "Bash(bin/preview:*) in ~/Projects/fivepicks — routine local preview workflow per CLAUDE.md",
      "Bash(rake games:sync_season:*) in ~/Projects/fivepicks — routine schedule sync task",
      "Bash(rake pool:ingest:*) in ~/Projects/fivepicks — routine backfill task documented as safe/idempotent"
    ],
    "soft_deny": [
      "$defaults",
      "Bash(fly secrets set:* --app sportslook) — production secret writes to the live Fly app",
      "Bash(fly volumes:* --app sportslook) — production volume operations (data loss risk per CLAUDE.md backup/restore warnings)"
    ]
  }
}
